<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Icon="pack://application:,,,/app.ico"
        Width="660" Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseWheel="Window_MouseWheel"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Flat Icon Button Style -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Arrow Circle Button (< and >) -->
        <Style x:Key="NavCircleBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Width="22" Height="22" CornerRadius="11" Background="#28282C">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#3E3E44"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#52525A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Context Menu for Quick Actions -->
    <Window.ContextMenu>
        <ContextMenu Background="#18181B" Foreground="White" BorderBrush="#333338">
            <MenuItem x:Name="MenuPinItem" Header="📌 Pin Dynamic Island (Stay Expanded)" Click="MenuPin_Click"/>
            <MenuItem Header="↔️ Reset Position to Center" Click="MenuResetPosition_Click"/>
            <Separator Background="#2E2E34"/>
            <MenuItem Header="🎵 Page 1: Music &amp; Lyrics" Click="MenuJumpPage0_Click"/>
            <MenuItem Header="⏱️ Page 2: Pomodoro Timer" Click="MenuJumpPage1_Click"/>
            <MenuItem Header="💧 Page 3: Water Reminder" Click="MenuJumpPage2_Click"/>
            <MenuItem Header="📁 Page 4: File Shelf" Click="MenuJumpPage3_Click"/>
            <MenuItem Header="✅ Page 5: TodoList" Click="MenuJumpPage4_Click"/>
            <MenuItem Header="🔍 Page 6: Browser Search" Click="MenuJumpPage5_Click"/>
            <Separator Background="#2E2E34"/>
            <MenuItem Header="🎧 Preview Bluetooth Toast (Bluetooth Audio)" Click="MenuTestBluetooth_Click"/>
            <Separator Background="#2E2E34"/>
            <MenuItem Header="❌ Exit" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Root Container aligned to Top-Center (Supports dragging left/right along top edge) -->
    <Grid x:Name="RootIslandGrid" HorizontalAlignment="Center" VerticalAlignment="Top"
          PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown"
          PreviewMouseMove="RootGrid_PreviewMouseMove"
          PreviewMouseLeftButtonUp="RootGrid_PreviewMouseLeftButtonUp">

        <!-- Custom Notch Silhouette Path -->
        <Path x:Name="NotchShapePath" Fill="#000000" HorizontalAlignment="Center" VerticalAlignment="Top"
              Cursor="SizeWE" ToolTip="Hold &amp; drag left/right to move position">
            <Path.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
            </Path.Effect>
        </Path>

        <!-- Ambient Bottom Glow Overlay (Visible in Music Lyrics mode) -->
        <Path x:Name="AmbientGlowPath" HorizontalAlignment="Center" VerticalAlignment="Top"
              Opacity="0" IsHitTestVisible="False">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0.5,0.1" EndPoint="0.5,1.0">
                    <GradientStop Color="#00000000" Offset="0.0"/>
                    <GradientStop x:Name="AmbientGlowMidStop" Color="#558C1528" Offset="0.55"/>
                    <GradientStop x:Name="AmbientGlowBottomStop" Color="#CC9B1B30" Offset="1.0"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- Active Content Container sized to the Island Body -->
        <Grid x:Name="IslandBodyContainer" Width="450" Height="180"
              HorizontalAlignment="Center" VerticalAlignment="Top">

            <!-- ========================================================= -->
            <!-- 1. COLLAPSED / COMPACT MINI NOTCH STATE                   -->
            <!-- ========================================================= -->
            <Grid x:Name="CompactStatePanel" Visibility="Collapsed"
                  Margin="16,0,16,0" VerticalAlignment="Center" Height="34"
                  MouseLeftButtonDown="CompactPanel_MouseLeftButtonDown" Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Mini Album Art or Battery Ring -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="CompactAlbumBorder" Width="20" Height="20" CornerRadius="5"
                            Margin="0,0,8,0" ClipToBounds="True" Visibility="Collapsed">
                        <Image x:Name="CompactAlbumImage" Stretch="UniformToFill"/>
                    </Border>
                    <Canvas Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse Width="16" Height="16" Stroke="#1F472A" StrokeThickness="2.3"/>
                        <Path x:Name="CompactBatteryArc" Stroke="#4ADE80" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </StackPanel>

                <!-- Center: Compact Title / Clock -->
                <TextBlock x:Name="CompactCenterText" Grid.Column="1"
                           Text="Sat 17 Oct 2026  19:25"
                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="2,0,8,0"/>

                <!-- Right: Mini Waveform -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="14">
                    <Border x:Name="MiniWave1" Width="2.2" Height="5" CornerRadius="1" Background="#FFFFFF" Margin="1,0" VerticalAlignment="Center"/>
                    <Border x:Name="MiniWave2" Width="2.2" Height="11" CornerRadius="1" Background="#FF85A1" Margin="1,0" VerticalAlignment="Center"/>
                    <Border x:Name="MiniWave3" Width="2.2" Height="8" CornerRadius="1" Background="#FFFFFF" Margin="1,0" VerticalAlignment="Center"/>
                    <Border x:Name="MiniWave4" Width="2.2" Height="12" CornerRadius="1" Background="#FF85A1" Margin="1,0" VerticalAlignment="Center"/>
                    <Border x:Name="MiniWave5" Width="2.2" Height="5" CornerRadius="1" Background="#FFFFFF" Margin="1,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ========================================================= -->
            <!-- 2. BLUETOOTH CONNECTED TOAST STATE (Screenshot 014600)    -->
            <!-- ========================================================= -->
            <Grid x:Name="BluetoothToastPanel" Visibility="Collapsed"
                  Margin="22,6,22,10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Blue Battery Ring + Bluetooth Icon -->
                <Grid Grid.Column="0" Width="46" Height="46" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse Width="44" Height="44" Stroke="#1D2B36" StrokeThickness="4.5"/>
                    <Path x:Name="BtToastBatteryArc" Stroke="#58B9F7" StrokeThickness="4.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <!-- Bluetooth Rune Symbol -->
                    <Path Data="M 19,15 L 27,23 L 23,27 L 23,11 L 27,15 L 19,23"
                          Stroke="White" StrokeThickness="2.0"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                </Grid>

                <!-- Center: Device Name + Connected % -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="BtToastDeviceName" Text="Bluetooth Audio"
                               Foreground="White" FontSize="16" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="BtToastSubtitle" Text="Connected - 80%"
                               Foreground="#98989F" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Right: Headphone Circle Icon -->
                <Grid Grid.Column="2" Width="40" Height="40" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="38" Height="38" Stroke="#3A5870" StrokeThickness="1.8" Fill="#111920"/>
                    <!-- Headphone Band (Open Arc) -->
                    <Path Data="M 12,23 L 12,19 A 8,8 0 0 1 28,19 L 28,23"
                          Stroke="#F2D7DF" StrokeThickness="2.2" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <!-- Headphone Earcups (Filled) -->
                    <Path Data="M 10,21 A 2.4,2.4 0 0 1 14.5,21 L 14.5,26.5 A 2.4,2.4 0 0 1 10,26.5 Z M 25.5,21 A 2.4,2.4 0 0 1 30,21 L 30,26.5 A 2.4,2.4 0 0 1 25.5,26.5 Z"
                          Fill="#F2D7DF"/>
                </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- 3. EXPANDED MAIN ISLAND STATE (5 PAGES)                   -->
            <!-- ========================================================= -->
            <Grid x:Name="ExpandedStatePanel" Visibility="Visible">

                <!-- TOP HEADER BAR (Shared across pages, customized per page) -->
                <Grid x:Name="TopHeaderBar" Height="26" VerticalAlignment="Top" Margin="20,8,20,0" Panel.ZIndex="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Top-Left Page Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitlePrimary" Text=""
                                   Foreground="White" FontSize="14.5" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderTitleAccent" Text=""
                                   Foreground="#5AB9EA" FontSize="14.5" FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- Shelf "Clear" Pill Button (Only visible on Page 3: Shelf) -->
                        <Button x:Name="ShelfClearBtn" Visibility="Collapsed"
                                Style="{StaticResource IconBtn}"
                                Background="#1C1C1F" Padding="10,2" Margin="10,0,0,0"
                                Click="ShelfClearBtn_Click" ToolTip="Clear all files from Shelf">
                            <TextBlock Text="Clear" Foreground="#D4D4D8" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>

                    <!-- Top-Center Battery Ring + Date & Time -->
                    <StackPanel x:Name="HeaderClockPanel" Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Cursor="SizeWE"
                                ToolTip="Hold &amp; drag left/right to move position (Right-click for Pin option)">
                        <Canvas Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse Width="16" Height="16" Stroke="#1E3F24" StrokeThickness="2.4"/>
                            <Path x:Name="HeaderBatteryArc" Stroke="#4ADE80" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                        <TextBlock x:Name="HeaderDateText" Text="Sat 17 Oct 2026 "
                                   Foreground="#E4E4E7" FontSize="12.5" FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderTimeText" Text="19:25"
                                   Foreground="White" FontSize="12.5" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PinIndicatorIcon" Text=" 📌" FontSize="10"
                                   VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Top-Right Quick Search Button + Audio Waveform / Status Badge -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick Browser Search Button (Opens Page 6 Search Bar from anywhere) -->
                        <Button x:Name="HeaderSearchBtn" Style="{StaticResource IconBtn}"
                                Padding="5,3" Margin="0,0,7,0" VerticalAlignment="Center"
                                Click="HeaderSearchBtn_Click"
                                ToolTip="Quick Browser Search (Type query or URL)">
                            <Path Data="M 6.5,1.5 A 5,5 0 1 1 6.49,1.5 M 10.2,10.2 L 14,14"
                                  Stroke="#D4D4D8" StrokeThickness="1.6" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>

                        <Grid VerticalAlignment="Center">
                            <!-- Audio Waveform Bars -->
                            <StackPanel x:Name="HeaderWaveformPanel" Orientation="Horizontal"
                                        VerticalAlignment="Center" Height="16" Cursor="Hand"
                                        MouseLeftButtonDown="HeaderWaveform_Click"
                                        ToolTip="Audio Visualizer (Click to jump to Music)">
                                <Border x:Name="WaveBar1" Width="2.4" Height="5" CornerRadius="1.2" Background="#F4F4F6" Margin="1.1,0" VerticalAlignment="Center"/>
                                <Border x:Name="WaveBar2" Width="2.4" Height="12" CornerRadius="1.2" Background="#F5C2C7" Margin="1.1,0" VerticalAlignment="Center"/>
                                <Border x:Name="WaveBar3" Width="2.4" Height="8" CornerRadius="1.2" Background="#FFFFFF" Margin="1.1,0" VerticalAlignment="Center"/>
                                <Border x:Name="WaveBar4" Width="2.4" Height="14" CornerRadius="1.2" Background="#F5C2C7" Margin="1.1,0" VerticalAlignment="Center"/>
                                <Border x:Name="WaveBar5" Width="2.4" Height="5" CornerRadius="1.2" Background="#F4F4F6" Margin="1.1,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Red Status Circle Badge (Seen in Water Reminder & TodoList top-right) -->
                            <Border x:Name="HeaderRedBadge" Visibility="Collapsed"
                                    Width="20" Height="20" CornerRadius="10"
                                    Background="#2A1215" BorderBrush="#E53935" BorderThickness="1.5"
                                    Cursor="Hand" MouseLeftButtonDown="HeaderRedBadge_Click"
                                    ToolTip="Switch to Pomodoro Timer">
                                <Path Data="M 2,12 Q 7,7 12,11 Q 16,14 18,9 L 18,18 L 2,18 Z"
                                      Fill="#E53935" ClipToBounds="True"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- LEFT & RIGHT CAROUSEL ARROWS (< and >) -->
                <Button x:Name="PrevPageBtn" Style="{StaticResource NavCircleBtn}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Margin="10,6,0,0" Panel.ZIndex="20"
                        Click="PrevPageBtn_Click" ToolTip="Previous Page">
                    <Path Data="M 13,6 L 8,11 L 13,16" Stroke="White" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>

                <Button x:Name="NextPageBtn" Style="{StaticResource NavCircleBtn}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,6,10,0" Panel.ZIndex="20"
                        Click="NextPageBtn_Click" ToolTip="Next Page">
                    <Path Data="M 9,6 L 14,11 L 9,16" Stroke="White" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>

                <!-- ===================================================== -->
                <!-- PAGE 0: MUSIC PLAYER & LIVE LYRICS                    -->
                <!-- ===================================================== -->
                <Grid x:Name="Page0Music" Visibility="Visible" Margin="38,12,38,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MusicLeftCol" Width="*"/>
                        <ColumnDefinition x:Name="MusicRightLyricsCol" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left / Main Music Player Controls -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Album Art + Track Title/Artist -->
                        <Grid Grid.Row="0" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Rounded Album Cover -->
                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="12"
                                    Background="#1E1E22" ClipToBounds="True" Margin="0,0,14,0">
                                <Image x:Name="MusicAlbumImage" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <!-- Song Title & Artist (pushed down slightly to clear top clock header) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,22,0,4">
                                <TextBlock x:Name="MusicTitleText" Text="No Media Playing"
                                           Foreground="White" FontSize="15.5" FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MusicArtistText" Text="Play music on Spotify or Browser"
                                           Foreground="#8E8E93" FontSize="12.5" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Timeline Progress Bar -->
                        <Grid Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="MusicElapsedText" Grid.Column="0" Text="00:00"
                                       Foreground="White" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center"/>

                            <!-- Clickable Progress Bar -->
                            <Grid x:Name="MusicProgressContainer" Grid.Column="1" Height="14"
                                  Margin="8,0" VerticalAlignment="Center" Cursor="Hand"
                                  Background="Transparent"
                                  MouseLeftButtonDown="MusicProgress_MouseLeftButtonDown">
                                <Border Height="4.5" CornerRadius="2.25" Background="#48484A" VerticalAlignment="Center"/>
                                <Border x:Name="MusicProgressFill" Height="4.5" CornerRadius="2.25"
                                        Background="White" HorizontalAlignment="Left" Width="4"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="MusicRemainingText" Grid.Column="2" Text="-00:00"
                                       Foreground="#C7C7CC" FontSize="13" FontWeight="Medium"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 2: Bottom Transport Controls + Lyrics Button -->
                        <Grid Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center">
                            <!-- Lyrics Quote Button on Left -->
                            <Button x:Name="LyricsToggleBtn" Style="{StaticResource IconBtn}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="10,0,0,0" Padding="4"
                                    Click="LyricsToggleBtn_Click" ToolTip="Toggle Live Synced Lyrics">
                                <Grid Width="22" Height="20">
                                    <!-- Outlined Speech Bubble (Off State) -->
                                    <Path x:Name="LyricsIconOff"
                                          Data="M 3,2 L 17,2 A 2.5,2.5 0 0 1 19.5,4.5 L 19.5,12.5 A 2.5,2.5 0 0 1 17,15 L 8,15 L 4,18.5 L 4,15 L 3,15 A 2.5,2.5 0 0 1 0.5,12.5 L 0.5,4.5 A 2.5,2.5 0 0 1 3,2 Z M 7,7 L 7,10 M 13,7 L 13,10"
                                          Stroke="#E5E5EA" StrokeThickness="1.6" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <!-- Solid Filled Speech Bubble (On State - Screenshot 014438) -->
                                    <Path x:Name="LyricsIconOn" Visibility="Collapsed"
                                          Data="M 3,2 L 17,2 A 2.5,2.5 0 0 1 19.5,4.5 L 19.5,12.5 A 2.5,2.5 0 0 1 17,15 L 8,15 L 4,18.5 L 4,15 L 3,15 A 2.5,2.5 0 0 1 0.5,12.5 L 0.5,4.5 A 2.5,2.5 0 0 1 3,2 Z"
                                          Fill="White"/>
                                    <Path x:Name="LyricsQuotesOn" Visibility="Collapsed"
                                          Data="M 7,6.5 L 7,10.5 M 13,6.5 L 13,10.5"
                                          Stroke="#2A0F15" StrokeThickness="2.0"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Grid>
                            </Button>

                            <!-- Center Rewind / Play-Pause / Fast-Forward -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconBtn}" Padding="8,4" Margin="6,0"
                                        Click="MusicPrevBtn_Click" ToolTip="Previous Track">
                                    <Path Data="M 10,3 L 2,9 L 10,15 Z M 18,3 L 10,9 L 18,15 Z" Fill="White"/>
                                </Button>

                                <Button Style="{StaticResource IconBtn}" Padding="10,4" Margin="10,0"
                                        Click="MusicPlayPauseBtn_Click" ToolTip="Play / Pause">
                                    <Grid Width="18" Height="18">
                                        <!-- Pause Icon -->
                                        <Path x:Name="MusicPauseIcon" Visibility="Visible"
                                              Data="M 3,2 L 7,2 L 7,16 L 3,16 Z M 11,2 L 15,2 L 15,16 L 11,16 Z"
                                              Fill="White"/>
                                        <!-- Play Icon -->
                                        <Path x:Name="MusicPlayIcon" Visibility="Collapsed"
                                              Data="M 4,2 L 16,9 L 4,16 Z"
                                              Fill="White"/>
                                    </Grid>
                                </Button>

                                <Button Style="{StaticResource IconBtn}" Padding="8,4" Margin="6,0"
                                        Click="MusicNextBtn_Click" ToolTip="Next Track">
                                    <Path Data="M 2,3 L 10,9 L 2,15 Z M 10,3 L 18,9 L 10,15 Z" Fill="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Right Live Synced Lyrics Panel (Visible when LyricsOpen == true) -->
                    <Border x:Name="LyricsRightPanel" Grid.Column="1" Visibility="Collapsed"
                            Margin="16,24,0,4" Padding="8,4,0,4">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LyricsCurrentLineText"
                                       Text="Play your favorite track"
                                       Foreground="White" FontSize="14.5" FontWeight="Bold"
                                       TextWrapping="Wrap" LineHeight="19" MaxHeight="58"/>
                            <TextBlock x:Name="LyricsNextLineText"
                                       Text="Synced lyrics will appear here"
                                       Foreground="#75FFFFFF" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" LineHeight="17" Margin="0,10,0,0" MaxHeight="38"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===================================================== -->
                <!-- PAGE 1: POMODORO TIMER (Screenshot 014536)            -->
                <!-- ===================================================== -->
                <Grid x:Name="Page1Pomodoro" Visibility="Collapsed" Margin="34,36,30,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Red Circular Progress Ring + Stopwatch Icon -->
                    <Grid Grid.Column="0" Width="82" Height="82" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse Width="78" Height="78" Stroke="#3A1518" StrokeThickness="7"/>
                        <Path x:Name="PomodoroRingArc" Stroke="#E53935" StrokeThickness="7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <!-- White Stopwatch Icon in Center -->
                        <Canvas Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Top Stem & Side Clicker -->
                            <Line X1="16" Y1="6" X2="24" Y2="6" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="20" Y1="6" X2="20" Y2="10" Stroke="White" StrokeThickness="2.6"/>
                            <Line X1="28" Y1="10" X2="31" Y2="7" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <!-- Stopwatch Body -->
                            <Ellipse Canvas.Left="7" Canvas.Top="10" Width="26" Height="26" Stroke="White" StrokeThickness="2.6"/>
                            <!-- Hand -->
                            <Line X1="20" Y1="23" X2="20" Y2="15" Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Grid>

                    <!-- Right: 25:00 Countdown + Focus Time + Mode & Play Buttons -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Time + Reset Icon -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="PomodoroTimeText" Text="25:00"
                                       Foreground="White" FontSize="32" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconBtn}" Padding="6" Margin="10,2,0,0"
                                    VerticalAlignment="Center" Click="PomodoroResetBtn_Click"
                                    ToolTip="Reset Timer">
                                <Path Data="M 12,4 A 6,6 0 1 1 6,10 M 12,1 L 12,5 L 8,5"
                                      Stroke="#E5E5EA" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="PomodoroModeSubtitle" Text="Focus time"
                                   Foreground="#8E8E93" FontSize="12" HorizontalAlignment="Center"
                                   Margin="0,1,0,8"/>

                        <!-- Bottom Row: Short Break | Red Play Pill | Focus Time -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="PomoShortBreakBtn" Style="{StaticResource IconBtn}"
                                    Background="Transparent" Padding="9,5" Margin="0,0,6,0"
                                    Click="PomoShortBreakBtn_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Coffee Cup Vector Icon -->
                                    <Path Data="M 1,3 L 9,3 L 9,8 A 3,3 0 0 1 6,11 L 4,11 A 3,3 0 0 1 1,8 Z M 9,4.5 L 11,4.5 A 1.5,1.5 0 0 1 11,7.5 L 9,7.5"
                                          Stroke="White" StrokeThickness="1.4" Fill="Transparent" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Short Break" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Red Pill Play/Pause Button -->
                            <Button Style="{StaticResource IconBtn}" Click="PomodoroPlayPauseBtn_Click"
                                    Margin="2,0">
                                <Border Width="52" Height="28" CornerRadius="14" Background="#E53935">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="PomoPlayIcon" Data="M 0,0 L 9,5.5 L 0,11 Z" Fill="White" Margin="2,0,0,0"/>
                                        <Path x:Name="PomoPauseIcon" Visibility="Collapsed"
                                              Data="M 0,0 L 3,0 L 3,11 L 0,11 Z M 6,0 L 9,0 L 9,11 L 6,11 Z" Fill="White"/>
                                    </Grid>
                                </Border>
                            </Button>

                            <Button x:Name="PomoFocusTimeBtn" Style="{StaticResource IconBtn}"
                                    Background="#262629" Padding="10,5" Margin="6,0,0,0"
                                    Click="PomoFocusTimeBtn_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Target Bullseye Vector Icon -->
                                    <Grid Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="1.4"/>
                                        <Ellipse Width="6" Height="6" Stroke="White" StrokeThickness="1.3"/>
                                        <Ellipse Width="2.2" Height="2.2" Fill="White"/>
                                    </Grid>
                                    <TextBlock Text="Focus Time" FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===================================================== -->
                <!-- PAGE 2: WATER REMINDER (Screenshots 014543 & 014548)  -->
                <!-- ===================================================== -->
                <Grid x:Name="Page2Water" Visibility="Collapsed" Margin="44,34,44,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Intake, Bell Switch, Progress Bar, Drink & Settings Buttons -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- 0.0 / 1.5 L + Bell Reminder Switch -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="WaterCurrentText" Text="0.0"
                                           Foreground="White" FontSize="28" FontWeight="Bold"/>
                                <TextBlock x:Name="WaterGoalText" Text=" / 1.5 L"
                                           Foreground="#A1A1AA" FontSize="13.5" FontWeight="SemiBold"
                                           VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                            </StackPanel>

                            <!-- Bell Reminder Toggle Switch -->
                            <Border x:Name="WaterReminderSwitchTrack" Width="44" Height="22" CornerRadius="11"
                                    Background="#27272A" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,8,0" Cursor="Hand"
                                    MouseLeftButtonDown="WaterReminderSwitch_Click"
                                    ToolTip="Toggle Water Reminders">
                                <Grid>
                                    <Border x:Name="WaterReminderSwitchThumb" Width="18" Height="18" CornerRadius="9"
                                            Background="White" HorizontalAlignment="Left" Margin="2,0">
                                        <TextBlock x:Name="WaterBellIcon" Text="🔔" FontSize="9.5"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Subtitle: Today · 0% · Reminders off -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,5">
                            <TextBlock Text="Today · " Foreground="#A1A1AA" FontSize="11.5"/>
                            <TextBlock x:Name="WaterPercentInlineText" Text="0%" Foreground="#A1A1AA" FontSize="11.5" FontWeight="Bold"/>
                            <TextBlock x:Name="WaterReminderStatusText" Text=" · Reminders off" Foreground="#A1A1AA" FontSize="11.5"/>
                        </StackPanel>

                        <!-- Horizontal Progress Bar -->
                        <Grid Height="5" Margin="0,0,12,10">
                            <Border CornerRadius="2.5" Background="#27272A"/>
                            <Border x:Name="WaterLinearBarFill" CornerRadius="2.5" Background="#A1A1AA"
                                    HorizontalAlignment="Left" Width="110"/>
                        </Grid>

                        <!-- Bottom Buttons: Drink & Settings -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconBtn}" Click="WaterDrinkBtn_Click"
                                    ToolTip="Drink +250 ml water">
                                <Border Background="#173A64" CornerRadius="13" Padding="12,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 5,1 C 5,1 1,6 1,8.5 A 4,4 0 0 0 9,8.5 C 9,6 5,1 5,1 Z"
                                              Fill="#5AB9EA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Drink" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                            <Button Style="{StaticResource IconBtn}" Margin="8,0,0,0"
                                    Click="WaterSettingsBtn_Click"
                                    ToolTip="Click to cycle Daily Goal (1.5L / 2.0L / 2.5L) or Reset">
                                <Border Background="#18181B" CornerRadius="13" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚙ " Foreground="#D4D4D8" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="WaterSettingsBtnLabel" Text="Settings" Foreground="#D4D4D8" FontSize="11.5" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Column: Sub-View 0 (Ring Gauge) & Sub-View 1 (Hourly Bar Chart) -->
                    <Grid Grid.Column="1" Cursor="Hand" Background="Transparent"
                          MouseLeftButtonDown="WaterRightPanel_Click"
                          ToolTip="Click to switch between Ring Gauge and Hourly Chart">

                        <!-- Sub-View Toggle Dots (• ·) at Top-Right -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0">
                            <Ellipse x:Name="WaterSubDot0" Width="5" Height="5" Fill="White" Margin="2,0"/>
                            <Ellipse x:Name="WaterSubDot1" Width="4" Height="4" Fill="#666666" Margin="2,0"/>
                        </StackPanel>

                        <!-- Sub-View 0: Circular 270° Gauge (Screenshot 014543) -->
                        <Grid x:Name="WaterRingSubView" Visibility="Visible" Width="92" Height="92"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
                            <Path x:Name="WaterGaugeBgArc" Stroke="#27272A" StrokeThickness="6.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path x:Name="WaterGaugeValueArc" Stroke="#9CA3AF" StrokeThickness="6.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse x:Name="WaterGaugeTipDot" Width="8" Height="8" Fill="#D4D4D8"
                                     HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock x:Name="WaterGaugeCenterNumber" Text="0"
                                           Foreground="White" FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,-2,0,0">
                                    <Path Data="M 4,1 C 4,1 1,5 1,7 A 3,3 0 0 0 7,7 C 7,5 4,1 4,1 Z"
                                          Fill="#9CA3AF" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="%" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Sub-View 1: Hourly Intake Bar Chart (Screenshot 014548) -->
                        <Grid x:Name="WaterChartSubView" Visibility="Collapsed"
                              Margin="6,14,0,2" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bars + X-Axis -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>

                                <!-- Baseline + Bars Canvas -->
                                <Border Grid.Row="0" BorderBrush="#27272A" BorderThickness="0,0,1,1" Padding="6,4,6,0">
                                    <StackPanel x:Name="WaterChartBarsPanel" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                </Border>

                                <!-- X-Axis Labels (15   18) -->
                                <Grid Grid.Row="1" Margin="8,2,8,0">
                                    <TextBlock Text="15" Foreground="#8E8E93" FontSize="10" HorizontalAlignment="Left"/>
                                    <TextBlock Text="18" Foreground="#8E8E93" FontSize="10" HorizontalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </Grid>

                            <!-- Y-Axis Labels (600, 300, 0 ml) -->
                            <Grid Grid.Column="1" Margin="6,0,0,16">
                                <TextBlock Text="600" Foreground="#8E8E93" FontSize="9.5" VerticalAlignment="Top"/>
                                <TextBlock Text="300" Foreground="#8E8E93" FontSize="9.5" VerticalAlignment="Center"/>
                                <TextBlock Text="0 ml" Foreground="#8E8E93" FontSize="9.5" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===================================================== -->
                <!-- PAGE 3: SHELF - FILE DROP (Screenshot 014642)         -->
                <!-- ===================================================== -->
                <Grid x:Name="Page3Shelf" Visibility="Collapsed" Margin="44,36,44,22">
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ShelfItemsContainer" Orientation="Horizontal"
                                    VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </ScrollViewer>

                    <!-- Empty State Hint -->
                    <Border x:Name="ShelfEmptyHint" Visibility="Collapsed"
                            BorderBrush="#2E2E34" BorderThickness="1.2" CornerRadius="14"
                            Background="#0C0C0E" Padding="20,14" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonDown="ShelfEmptyHint_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📂 " FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Drag &amp; Drop files or folders here"
                                           Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Or click to add files to Shelf"
                                           Foreground="#8E8E93" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===================================================== -->
                <!-- PAGE 4: TODOLIST (Screenshot 014554)                  -->
                <!-- ===================================================== -->
                <Grid x:Name="Page4Todo" Visibility="Collapsed" Margin="44,34,38,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.92*"/>
                        <ColumnDefinition Width="1.18*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: 0/0 Task Done Today + Add/Edit Task Buttons -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TodoCountText" Text="0/0"
                                   Foreground="White" FontSize="34" FontWeight="Bold"
                                   Margin="2,0,0,0"/>
                        <TextBlock Text="Task Done Today"
                                   Foreground="#8E8E93" FontSize="12"
                                   Margin="2,2,0,14"/>

                        <!-- Add Task & Edit Task Action Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconBtn}" Padding="4,4" Margin="0,0,10,0"
                                    Click="TodoAddTaskBtn_Click" ToolTip="Add a new task">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="15" Height="15" CornerRadius="7.5" Background="White" Margin="0,0,5,0">
                                        <TextBlock Text="+" Foreground="Black" FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                    <TextBlock Text="Add Task" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource IconBtn}" Padding="4,4"
                                    Click="TodoEditTaskBtn_Click" ToolTip="Toggle Edit / Delete mode">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✎ " Foreground="#D4D4D8" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TodoEditBtnLabel" Text="Edit Task" Foreground="#D4D4D8" FontSize="11.5" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Column: Task List + Inline Add Box -->
                    <Grid Grid.Column="1" Margin="8,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Inline Add Task Bar (Hidden until + Add Task is clicked) -->
                        <Border x:Name="TodoAddInputPanel" Grid.Row="0" Visibility="Collapsed"
                                Background="#1C1C21" CornerRadius="8" Padding="8,4" Margin="0,0,10,6"
                                BorderBrush="#4ADE80" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TodoNewTitleBox" Grid.Column="0"
                                         Background="Transparent" Foreground="White" CaretBrush="White"
                                         BorderThickness="0" FontSize="12" VerticalContentAlignment="Center"
                                         KeyDown="TodoNewTitleBox_KeyDown"/>
                                <Button Grid.Column="1" Style="{StaticResource IconBtn}" Padding="6,2"
                                        Click="TodoConfirmAddBtn_Click">
                                    <TextBlock Text="Add" Foreground="#4ADE80" FontSize="11.5" FontWeight="Bold"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Tasks List with Custom Thin Scrollbar -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer x:Name="TodoScrollViewer" Grid.Column="0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="TodoScrollViewer_PreviewMouseWheel">
                                <StackPanel x:Name="TodoItemsStack" VerticalAlignment="Top"/>
                            </ScrollViewer>

                            <!-- Sleek Vertical Scroll Indicator Bar (Matches Screenshot 014554) -->
                            <Border Grid.Column="1" Width="3" CornerRadius="1.5" Background="#E4E4E7"
                                    Margin="0,4,0,6" VerticalAlignment="Stretch" Opacity="0.85"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ===================================================== -->
                <!-- PAGE 5: CLEAN BROWSER SEARCH BAR                      -->
                <!-- ===================================================== -->
                <Grid x:Name="Page5Search" Visibility="Collapsed" Margin="44,36,44,22" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <!-- Single Clean & Spacious Search / URL Input Bar -->
                        <Border Height="40" CornerRadius="20"
                                Background="#141418" BorderBrush="#33333A" BorderThickness="1.2"
                                Padding="14,0,6,0" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Magnifying Glass Icon -->
                                <Path Grid.Column="0" Data="M 6,1 A 5,5 0 1 1 5.99,1 M 9.8,9.8 L 13.5,13.5"
                                      Stroke="#A1A1AA" StrokeThickness="1.7" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <!-- Search / URL TextBox + Placeholder -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="WebSearchPlaceholder"
                                               Text="Search Google or type a URL..."
                                               Foreground="#71717A" FontSize="12.5"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBox x:Name="WebSearchInputBox"
                                             Background="Transparent" Foreground="White" CaretBrush="#60A5FA"
                                             BorderThickness="0" FontSize="12.5" FontWeight="Medium"
                                             VerticalContentAlignment="Center"
                                             TextChanged="WebSearchInputBox_TextChanged"
                                             KeyDown="WebSearchInputBox_KeyDown"/>
                                </Grid>

                                <!-- Clean Search Pill Button -->
                                <Button Grid.Column="2" Style="{StaticResource IconBtn}"
                                        Click="WebSearchSubmitBtn_Click" ToolTip="Open in Browser (Enter)">
                                    <Border Background="#2563EB" CornerRadius="14" Padding="13,5" Margin="6,0,0,0">
                                        <TextBlock Text="Search ↵" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                                    </Border>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Single Subtle Helper Caption -->
                        <TextBlock Text="Press Enter to search Google or open a URL"
                                   Foreground="#71717A" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- BOTTOM PAGINATION DOTS (— • • • • •) -->
                <StackPanel x:Name="PaginationDotsPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,7" Panel.ZIndex="20">
                    <Border x:Name="PageDot0" Width="18" Height="4" CornerRadius="2" Background="White" Margin="2.5,0" Cursor="Hand" MouseLeftButtonDown="PageDot0_Click"/>
                    <Border x:Name="PageDot1" Width="4" Height="4" CornerRadius="2" Background="#666666" Margin="2.5,0" Cursor="Hand" MouseLeftButtonDown="PageDot1_Click"/>
                    <Border x:Name="PageDot2" Width="4" Height="4" CornerRadius="2" Background="#666666" Margin="2.5,0" Cursor="Hand" MouseLeftButtonDown="PageDot2_Click"/>
                    <Border x:Name="PageDot3" Width="4" Height="4" CornerRadius="2" Background="#666666" Margin="2.5,0" Cursor="Hand" MouseLeftButtonDown="PageDot3_Click"/>
                    <Border x:Name="PageDot4" Width="4" Height="4" CornerRadius="2" Background="#666666" Margin="2.5,0" Cursor="Hand" MouseLeftButtonDown="PageDot4_Click"/>
                    <Border x:Name="PageDot5" Width="4" Height="4" CornerRadius="2" Background="#666666" Margin="2.5,0" Cursor="Hand" MouseLeftButtonDown="PageDot5_Click"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Window>
